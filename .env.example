# Copy to .env (gitignored) and fill in. Never commit .env.
#
# n8n base URL for webhooks (no trailing slash)
# e.g. https://your-n8n-instance.com or http://192.168.1.100:5678
EXPO_PUBLIC_N8N_BASE_URL=
# Optional: LAN address of the same instance, selectable in the app
EXPO_PUBLIC_N8N_LOCAL_BASE_URL=
# Sent as the `x-api-key` header on every /webhook/* call.
# In n8n, set each Webhook node to Authentication = Header Auth with
# name `x-api-key` and this value. Use a random secret (openssl rand -hex 32),
# NOT your n8n personal API key: EXPO_PUBLIC_* values are bundled into the app
# and can be extracted from it, so this must only be able to trigger webhooks.
EXPO_PUBLIC_N8N_API_KEY=
